rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'level', 'dailyGoalMinutes', 'streakDays',
        'xpTotal', 'lastPracticeDate', 'vocabMasteredCount',
        'quizzesCompleted', 'pronunciationAvg', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'displayName', 'level', 'dailyGoalMinutes', 'streakDays',
        'xpTotal', 'lastPracticeDate', 'vocabMasteredCount',
        'quizzesCompleted', 'pronunciationAvg', 'createdAt', 'updatedAt'
      ])
      && data.uid is string && data.uid == userId && data.uid == request.auth.uid && isValidId(data.uid)
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
      && data.level is string && data.level in ['A2', 'B1', 'B2', 'C1']
      && data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 180
      && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000
      && data.xpTotal is int && data.xpTotal >= 0 && data.xpTotal <= 10000000
      && data.lastPracticeDate is string && data.lastPracticeDate.size() >= 8 && data.lastPracticeDate.size() <= 20
      && data.vocabMasteredCount is int && data.vocabMasteredCount >= 0 && data.vocabMasteredCount <= 100000
      && data.quizzesCompleted is int && data.quizzesCompleted >= 0 && data.quizzesCompleted <= 100000
      && (data.pronunciationAvg is int || data.pronunciationAvg is float) && data.pronunciationAvg >= 0 && data.pronunciationAvg <= 100
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidVocabProgress(data, userId, wordId) {
      return data.keys().hasAll(['wordId', 'userId', 'word', 'status', 'correctCount', 'updatedAt'])
      && data.keys().hasOnly(['wordId', 'userId', 'word', 'status', 'correctCount', 'updatedAt'])
      && data.wordId is string && data.wordId == wordId && isValidId(data.wordId)
      && data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId)
      && data.word is string && data.word.size() >= 1 && data.word.size() <= 120
      && data.status is string && data.status in ['learning', 'mastered']
      && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 10000
      && data.updatedAt is timestamp;
    }

    function isValidPracticeSession(data, userId, sessionId) {
      return data.keys().hasAll(['sessionId', 'userId', 'mode', 'topic', 'score', 'summary', 'createdAt'])
      && data.keys().hasOnly(['sessionId', 'userId', 'mode', 'topic', 'score', 'summary', 'createdAt'])
      && data.sessionId is string && data.sessionId == sessionId && isValidId(data.sessionId)
      && data.userId is string && data.userId == userId && data.userId == request.auth.uid && isValidId(data.userId)
      && data.mode is string && data.mode in ['tutor', 'pronunciation', 'grammar', 'vocabulary']
      && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120
      && data.score is int && data.score >= 0 && data.score <= 100
      && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600
      && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'level', 'dailyGoalMinutes', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'streakDays', 'xpTotal', 'lastPracticeDate', 'vocabMasteredCount',
            'quizzesCompleted', 'pronunciationAvg', 'updatedAt'
          ])
        );
      allow delete: if false;

      match /vocabProgress/{wordId} {
        allow get: if isValidId(userId) && isValidId(wordId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(wordId)
          && isOwner(userId)
          && isValidVocabProgress(incoming(), userId, wordId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(wordId)
          && isOwner(userId)
          && isValidVocabProgress(incoming(), userId, wordId)
          && incoming().userId == existing().userId
          && incoming().wordId == existing().wordId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'correctCount', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(wordId) && isOwner(userId);
      }

      match /practiceSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(sessionId)
          && isOwner(userId)
          && isValidPracticeSession(incoming(), userId, sessionId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);
      }
    }
  }
}
